# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ (ห้าม commit ไฟล์ .env)
AIRFLOW_UID=50000

# บัญชีเข้า Airflow UI
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Postgres ปลายทาง (ข้อมูลราคา) — ใช้ร่วมกันทั้ง Airflow และเว็บ dashboard
TARGET_DB_NAME=etl_db
TARGET_DB_USER=etluser
TARGET_DB_PASSWORD=change-me
